# Server-only DeepSeek configuration. Never prefix these with NEXT_PUBLIC_.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Required in production for encrypted personal API Key cookies (at least 32 random characters).
COOKIE_ENCRYPTION_SECRET=

# Prisma SQLite database (relative to prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# Python media service
MEDIA_SERVICE_HOST=127.0.0.1
MEDIA_SERVICE_PORT=8001
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_PYTHON_PATH=python
MEDIA_STORAGE_ROOT=./storage
MEDIA_GENERATED_ROOT=./generated

# Phase 1 local media limits
MAX_IMAGE_UPLOAD_MB=50
MAX_VIDEO_UPLOAD_MB=2048
